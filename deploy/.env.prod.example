# 车研数合（CrossBorderPlatform）私有化生产部署环境变量示例
# 部署前请复制为 deploy/.env 并替换为强随机口令与企业自有密钥（执行 install_and_start 脚本时将自动初始化随机密钥）

POSTGRES_PASSWORD=CHANGE_ME_STRONG_PG_SUPER_PASSWORD
CYSH_RUNTIME_DB_PASSWORD=CHANGE_ME_STRONG_PG_RUNTIME_PASSWORD
CYSH_JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_RANDOM_HEX_SECRET
CYSH_PORTAL_SSO_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_PORTAL_SSO_SECRET

# 网关监听地址与端口（默认绑定本机 18080，前置反向代理或内网直连可按需修改）
CYSH_BIND_IP=0.0.0.0
CYSH_HTTP_PORT=18080
CYSH_CORS_ORIGINS=["http://localhost:18080"]
CYSH_RELEASE=v20261119

# 数据库连接池与容器内存限额（默认面向 8GB+ 企业服务器；小规格云主机可按需调小）
CYSH_DB_POOL_SIZE=20
CYSH_DB_MAX_OVERFLOW=20
CYSH_PG_MAX_CONNECTIONS=120
CYSH_PG_SHARED_BUFFERS=256MB
CYSH_DB_MEM_LIMIT=1g
CYSH_API_MEM_LIMIT=2g
CYSH_WORKER_MEM_LIMIT=512m

# 外部推理模型配置（支持 DeepSeek 或企业内网兼容 OpenAI 接口的私有化大模型）
CYSH_LLM_BASE_URL=https://api.deepseek.com/v1
CYSH_LLM_MODEL=deepseek-flash
CYSH_LLM_API_KEY=

# 舆情合规周报邮件推送配置（选填；留空时周报自动归档并同步至企业门户更新通知页）
CYSH_SMTP_HOST=
CYSH_SMTP_PORT=587
CYSH_SMTP_USER=
CYSH_SMTP_PASSWORD=
CYSH_SMTP_FROM=
