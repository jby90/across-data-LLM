# 复制为 .env 后填写。真实密钥仅保存在环境变量或本地未跟踪的 .env 中，切勿提交至代码仓库。
CYSH_ENV=dev
# 本地开发默认连接 PostgreSQL 16（如使用本地独立高并发实例，可将端口改为 15432 并填写对应库名）
CYSH_DATABASE_URL=postgresql+asyncpg://cyshuhe:change-me@127.0.0.1:5432/cyshuhe
# 至少 32 字符的高强度随机串，例如：python -c "import secrets; print(secrets.token_urlsafe(48))"
CYSH_JWT_SECRET=
CYSH_JWT_TTL_MINUTES=60
# 外部信息门户单点登录签名密钥（至少 32 字符随机串，未启用单点对接时可留空）
CYSH_PORTAL_SSO_SECRET=
# 采集：仅开发机在代理虚拟网段模式下才需要放行，例如 ["198.18.0.0/15"]；生产环境保持为空 []
CYSH_CRAWL_ALLOW_RESOLVED_CIDRS=[]
CYSH_ARCHIVE_DIR=./data/archive
CYSH_CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:5175","http://127.0.0.1:5173","http://127.0.0.1:5174","http://127.0.0.1:5175"]

# 数据库连接池与重任务并发保护（轻量云主机可调小为 6 / 6 / 1）
CYSH_DB_POOL_SIZE=25
CYSH_DB_MAX_OVERFLOW=35
CYSH_MAX_CONCURRENT_PDF_RENDERS=2

# 外部生成式语言服务配置（兼容标准对话接口，仅按需配置密钥，勿入库）
CYSH_LLM_BASE_URL=
CYSH_LLM_MODEL=
CYSH_LLM_API_KEY=

# 舆情合规周报多收件人邮件推送配置（选填；留空时自动归档至平台通知中心）
CYSH_SMTP_HOST=
CYSH_SMTP_PORT=587
CYSH_SMTP_USER=
CYSH_SMTP_PASSWORD=
CYSH_SMTP_FROM=

# 数据库容器口令（容器编排使用）
POSTGRES_PASSWORD=change-me
