<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<fontconfig>
  <!-- No system-font include: export only the three registered OFL families. -->
  <dir prefix="relative">inter</dir>
  <dir prefix="relative">notosanssc</dir>
  <dir prefix="relative">notonaskharabic</dir>
  <dir>/usr/share/fonts</dir>
  <alias>
    <family>Times New Roman</family>
    <prefer><family>Liberation Serif</family></prefer>
  </alias>
  <alias>
    <family>Arial</family>
    <prefer><family>Liberation Sans</family></prefer>
  </alias>
  <cachedir prefix="xdg">fontconfig</cachedir>
</fontconfig>
