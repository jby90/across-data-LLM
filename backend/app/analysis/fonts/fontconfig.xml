<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<fontconfig>
  <!-- Registered OFL-1.1 / permissive open-source fonts for WeasyPrint & LibreOffice PDF export. -->
  <dir>/usr/local/share/fonts/cyshuhe</dir>
  <dir prefix="relative">inter</dir>
  <dir prefix="relative">notosanssc</dir>
  <dir prefix="relative">notosanskr</dir>
  <dir prefix="relative">notosansthai</dir>
  <dir prefix="relative">notosansbengali</dir>
  <dir prefix="relative">notosanshebrew</dir>
  <dir prefix="relative">notonaskharabic</dir>
  <dir>/usr/share/fonts</dir>
  <alias>
    <family>Microsoft YaHei</family>
    <prefer>
      <family>Noto Sans SC</family>
      <family>Noto Sans KR</family>
      <family>Noto Sans Thai</family>
      <family>Noto Sans Bengali</family>
      <family>Noto Sans Hebrew</family>
      <family>Noto Naskh Arabic</family>
    </prefer>
  </alias>
  <alias>
    <family>Times New Roman</family>
    <prefer><family>Liberation Serif</family></prefer>
  </alias>
  <alias>
    <family>Arial</family>
    <prefer><family>Liberation Sans</family></prefer>
  </alias>
  <alias>
    <family>Calibri</family>
    <prefer><family>Liberation Sans</family></prefer>
  </alias>
  <alias>
    <family>Segoe UI Symbol</family>
    <prefer><family>DejaVu Sans</family></prefer>
  </alias>
  <alias>
    <family>Wingdings</family>
    <prefer><family>DejaVu Sans</family></prefer>
  </alias>
  <alias>
    <family>Wingdings 2</family>
    <prefer><family>DejaVu Sans</family></prefer>
  </alias>
  <alias>
    <family>Symbol</family>
    <prefer><family>DejaVu Sans</family></prefer>
  </alias>
  <alias>
    <family>仿宋_GB2312</family>
    <prefer><family>Noto Sans SC</family></prefer>
  </alias>
  <alias>
    <family>仿宋</family>
    <prefer><family>Noto Sans SC</family></prefer>
  </alias>
  <alias>
    <family>宋体</family>
    <prefer><family>Noto Sans SC</family></prefer>
  </alias>
  <alias>
    <family>SimSun</family>
    <prefer><family>Noto Sans SC</family></prefer>
  </alias>
  <alias>
    <family>楷体_GB2312</family>
    <prefer><family>Noto Sans SC</family></prefer>
  </alias>
  <alias>
    <family>楷体</family>
    <prefer><family>Noto Sans SC</family></prefer>
  </alias>
  <alias>
    <family>方正小标宋简体</family>
    <prefer><family>Noto Sans SC</family></prefer>
  </alias>
  <alias>
    <family>黑体</family>
    <prefer><family>Noto Sans SC</family></prefer>
  </alias>
  <alias>
    <family>SimHei</family>
    <prefer><family>Noto Sans SC</family></prefer>
  </alias>
  <cachedir prefix="xdg">fontconfig</cachedir>
</fontconfig>
